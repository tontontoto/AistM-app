FROM php:8.4-fpm

# システムパッケージのインストール
RUN apt-get update && apt-get install -y \
    git \
    curl \
    unzip \
    libpq-dev \
    libpng-dev \
    libjpeg-dev \
    libzip-dev \
    && rm -rf /var/lib/apt/lists/*

# PHP拡張機能のインストール
RUN docker-php-ext-configure gd --with-jpeg \
    && docker-php-ext-install pdo_mysql exif pcntl gd zip opcache

# Composerのインストール
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# 開発用: ソースはbind mountされる前提。
# 起動時に vendor をセットアップして php-fpm を foreground で起動する。
CMD ["sh", "-c", "composer install --no-interaction --prefer-dist && php-fpm -F"]

